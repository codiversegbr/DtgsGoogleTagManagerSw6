{% sw_extends '@Storefront/storefront/component/product/card/action.html.twig' %}

{% set gtmConfig = config('DtgsGoogleTagManagerSw6.config') %}

{% block component_product_box_action_detail %}
    <div class="d-grid">
        <a href="{{ seoUrl('frontend.detail.page', {'productId': id}) }}"
           class="btn btn-light btn-detail product-button-detail"
           title="{{ "listing.boxProductDetails"|trans|striptags }}">
            {{ "listing.boxProductDetails"|trans|sw_sanitize }}
        </a>
    </div>
    <input type="hidden"
           name="product-name"
           value="{{ product.translated.name }}">
    {% if not displayBuyButton %}
        {% sw_include 'storefront/plugins/TagManager/product-card-action.html.twig' %}
    {% endif %}
{% endblock %}

{% block component_product_box_action_inner %}

    {{ parent() }}

    {% if gtmConfig.pluginActiveInSaleschannel %}
        <input type="hidden"
               name="dtgs-gtm-product-sku"
               value="{{ product.productNumber }}">
    {%  endif %}
    {%  if gtmIsPluginInstalled('SwagCommercial') %}
        <input type="hidden"
               name="product-name"
               value="{{ product.translated.name }}">
    {%  endif %}

{% endblock %}

{% block component_product_box_action_buy_meta %}

    {{ parent() }}

    {% sw_include 'storefront/plugins/TagManager/product-card-action.html.twig' %}

{% endblock %}