{% set gtmConfig = config('DtgsGoogleTagManagerSw6.config') %}

{% if gtmConfig.pluginActiveInSaleschannel and gtmIsActive(gtmConfig.googleId) %}
    <script{% if app.request.attributes.get('_cspNonce') %} nonce="{{ app.request.attributes.get('_cspNonce') }}"{% endif %}>window.dtgsGtmConfig={containerIds:{{ gtmGetContainerIds(gtmConfig.googleId)|json_encode|raw }},gtmJsUrl:'{{ gtmGetJsUrl(gtmConfig.customGtmJsUrl) }}',gtmNoScriptUrl:'{{ gtmGetNoScriptUrl(gtmConfig.customGtmJsUrl) }}',customGtmJsUrl:'{{ gtmConfig.customGtmJsUrl|default('') }}',cspNonce:{% if app.request.attributes.get('_cspNonce') %}'{{ app.request.attributes.get('_cspNonce') }}'{% else %}null{% endif %},loadGoogleScriptAfterConsent:{{ gtmConfig.loadGoogleScriptAfterConsent ? 'true' : 'false' }},removeContainerCode:{{ gtmConfig.removeContainerCode ? 'true' : 'false' }}};window.dtgsLoadGTM=function(containerId){if(!window.dtgsGtmConfig||!containerId)return;const existingScript=document.querySelector('script[src*="'+containerId+'"]');if(existingScript)return;const w=window,d=document,s='script',l='dataLayer',i=containerId;w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});const f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!=='dataLayer'?'&l='+l:'';j.async=true;j.src=window.dtgsGtmConfig.gtmJsUrl+'?id='+i+dl;if(window.dtgsGtmConfig.cspNonce)j.setAttribute('nonce',window.dtgsGtmConfig.cspNonce);f.parentNode.insertBefore(j,f);if(!window.dtgsGtmConfig.removeContainerCode&&window.dtgsGtmConfig.loadGoogleScriptAfterConsent){const existingNoscript=document.querySelector('noscript.noscript-gtm iframe[src*="'+i+'"]');if(!existingNoscript){const addNoscript=function(){if(!d.body)return setTimeout(addNoscript,10);const noscript=d.createElement('noscript');noscript.className='noscript-gtm';const iframe=d.createElement('iframe');iframe.src=window.dtgsGtmConfig.gtmNoScriptUrl+'?id='+i;iframe.height='0';iframe.width='0';iframe.style.display='none';iframe.style.visibility='hidden';noscript.appendChild(iframe);d.body.insertBefore(noscript,d.body.firstChild)};addNoscript()}}};window.dtgsRemoveGTM=function(){const gtmScripts=document.querySelectorAll('script[src*="googletagmanager.com/gtm.js"], script[src*="/gtm.js"]');gtmScripts.forEach(script=>script.remove());const noscriptIframes=document.querySelectorAll('noscript.noscript-gtm iframe[src*="googletagmanager.com"], noscript.noscript-gtm iframe[src*="/ns.html"]');noscriptIframes.forEach(iframe=>{const noscript=iframe.closest('noscript');if(noscript)noscript.remove()});if(window.dataLayer)window.dataLayer.length=0};</script>
{% endif %}

{% if gtmConfig.pluginActiveInSaleschannel and gtmIsActive(gtmConfig.googleId) and page.extensions.dtgsAllowGtmTracking.gtmConsent %}
    {% for containerId in gtmGetContainerIds(gtmConfig.googleId) %}
        <script{% if app.request.attributes.get('_cspNonce') %} nonce="{{ app.request.attributes.get('_cspNonce') }}"{% endif %}{{ page.extensions.GoogleTagManagerConfig.additionalServiceCode|raw }}>
            window.dataLayer = window.dataLayer || [];
            {% if gtmConfig.loadGoogleScriptAfterConsent %}
                function handleCookieConsent(){try{let t=document.cookie.split(";").some(t=>t.trim().includes("dtgsAllowGtmTracking=1"));t&&window.dtgsLoadGTM("{{ containerId }}")}catch(e){}void 0!==document.$emitter?document.$emitter.subscribe("CookieConfiguration_Update",function(t){t.detail.hasOwnProperty("dtgsAllowGtmTracking")&&!0===t.detail.dtgsAllowGtmTracking&&window.dtgsLoadGTM("{{ containerId }}")}):setTimeout(handleCookieConsent,100)}"loading"===document.readyState?document.addEventListener("DOMContentLoaded",handleCookieConsent):handleCookieConsent();
            {% elseif page.extensions.GoogleTagManagerConfig.code_delay_active == true %}
                setTimeout(function () {
                    window.dtgsLoadGTM('{{ containerId }}');
                }, {{ gtmConfig.delayCodeInsertionTime }});
            {% else %}
                window.dtgsLoadGTM('{{ containerId }}');
            {% endif %}
        </script>
    {% endfor %}
{%  endif %}